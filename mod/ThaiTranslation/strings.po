#. STRINGS.BUILDING.STATUSITEMS.WELL_OVERPRESSURE.NAME
msgctxt "STRINGS.BUILDING.STATUSITEMS.WELL_OVERPRESSURE.NAME"
msgid "Overpressure"
msgstr "แรงดัน​เกิน"

