msgctxt "STRINGS.UI.BUILDINGEFFECTS.TOOLTIPS.HEATGENERATED_AIRCONDITIONER"
msgid ""
"Generates <style=\"KKeyword\">Heat</style> based on the <style=\"KKeyword\">Volume</style> and <style=\"KKeyword\">Specific Heat Capacity</style> of the pumped <style=\"KKeyword\">Gas</style>\n"
"\n"
"Cooling 1 kg of <link=\"OXYGEN\">Oxygen</link> the entire <b>{1}</b> will output <b>{0}</b>"
msgstr ""
"ผลิต<style=\"KKeyword\">ความร้อน</style>ตาม<style=\"KKeyword\">ปริมาตร</style>และ<style=\"KKeyword\">ความจุ​ความร้อน​จำเพาะ</style>ของ<style=\"KKeyword\">แก๊ส</style>ที่​สูบ\n"
"\n"
"ทำให้<link=\"OXYGEN\">ออกซิเจน</link> 1 kg เย็น​ลง​เต็ม <b>{1}</b> จะ​ปล่อย <b>{0}</b>"

