msgctxt "STRINGS.BUILDING.STATUSITEMS.VALVE.TOOLTIP"
msgid "This valve is allowing flow at a volume of <b>{MaxFlow}</b>"
msgstr "วาล์ว​นี้​ปล่อย​ให้​ไหล​ที่​ปริมาณ <b>{MaxFlow}</b>"

