msgctxt "STRINGS.BUILDING.STATUSITEMS.SUIT_LOCKER.SUIT_REQUESTED.TOOLTIP"
msgid "Waiting for a Duplicant to deliver a <style=\"KKeyword\">Suit</style>"
msgstr "รอ​ดู​พลิ​แคนต์​เอา<style=\"KKeyword\">ชุด</style>มา​ส่ง"

