msgstr "สายไฟ​เส้น​นี้​ไม่​ได้​เชื่อม​เครื่องใช้<style=\"KKeyword\">พลังงาน</style>เข้ากับ​เครื่อง​ผลิต<style=\"KKeyword\">พลังงาน</style>"

#. STRINGS.BUILDING.STATUSITEMS.WIREMAXWATTAGESTATUS.NAME
msgctxt "STRINGS.BUILDING.STATUSITEMS.WIREMAXWATTAGESTATUS.NAME"
