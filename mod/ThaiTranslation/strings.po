msgctxt "STRINGS.ELEMENTS.ELEMENTDESCLIQUID"
msgid ""
"Resource Type: {0}\n"
"Freezing point: {1}\n"
"Evaporation point: {2}"
msgstr ""
"ประเภท​ทรัพยากร: {0}\n"
"จุดเยือกแข็ง: {1}\n"
"จุด​ระเหย: {2}"

#. STRINGS.ELEMENTS.ELEMENTDESCSOLID
msgctxt "STRINGS.ELEMENTS.ELEMENTDESCSOLID"
msgid ""
"Resource Type: {0}\n"
"Melting point: {1}\n"
"Hardness: {2}"
msgstr ""
"ประเภท​ทรัพยากร: {0}\n"
