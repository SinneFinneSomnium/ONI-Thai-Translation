msgstr "<link=\"URCHINMEAT\">อู​นิ</link>"

#. STRINGS.ITEMS.FOOD.URCHINMEAT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.URCHINMEAT.RECIPEDESC"
msgid "The edible flesh of a <link=\"URCHIN\">Pinpoki</link> prepared at the <link=\"SUSHIBAR\">Sushi Bar</link>."
msgstr "เนื้อ​กิน​ได้​ของ<link=\"URCHIN\">พิน​โป​กิ</link>ที่​ปรุง​ที่<link=\"SUSHIBAR\">ซูชิ​บาร์</link>"

#. STRINGS.ITEMS.FOOD.VINEFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.VINEFRUIT.DESC"
msgid ""
"The fruit from an <link=\"VINEMOTHER\">Ovagro Vine</link>.\n"
"\n"
"It's fun to squeeze as many as possible into a single mouthful."
msgstr ""
"ผล​จาก<link=\"VINEMOTHER\">เถา​โอ​วา​โก​ร</link>\n"
"\n"
"สนุก​ดี​ที่​ได้​ลอง​ยัด​ให้ได้​มาก​ที่สุด​ใน​คำ​เดียว"

