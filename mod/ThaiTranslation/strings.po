msgstr "มี​ภูมิ​ต่อ<b>{0}</b>"

#. STRINGS.DUPLICANTS.TRAITS.INTERIORDECORATOR.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.INTERIORDECORATOR.DESC"
msgid "\"Move it a little to the left...\""
msgstr "\"ขยับ​ไป​ทางซ้าย​อีก​นิด...\""

#. STRINGS.DUPLICANTS.TRAITS.INTERIORDECORATOR.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.INTERIORDECORATOR.NAME"
msgid "Interior Decorator"
msgstr "มัณฑนากร"

#. STRINGS.DUPLICANTS.TRAITS.IRONGUT.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.IRONGUT.DESC"
msgid "This Duplicant can eat just about anything without getting sick"
msgstr "ดู​พลิ​แคนต์คน​นี้​กิน​ได้​แทบ​ทุกอย่าง​โดย​ไม่​ป่วย"

#. STRINGS.DUPLICANTS.TRAITS.IRONGUT.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.IRONGUT.NAME"
msgid "Iron Gut"
msgstr "กระเพาะ​เหล็ก"

#. STRINGS.DUPLICANTS.TRAITS.IRONGUT.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.IRONGUT.SHORT_DESC"
msgid "Immune to <b><link=\"FOODSICKNESS\">Food Poisoning</link></b>"
msgstr "มี​ภูมิ​ต่อ<b><link=\"FOODSICKNESS\">อาหาร​เป็นพิษ</link></b>"

#. STRINGS.DUPLICANTS.TRAITS.IRONGUT.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.IRONGUT.SHORT_DESC_TOOLTIP"
msgid "Eating food contaminated with <link=\"FOODSICKNESS\">Food Poisoning</link> Germs will not affect this Duplicant"
msgstr "การ​กิน​อาหาร​ที่​ปนเปื้อน​เชื้อ<link=\"FOODSICKNESS\">อาหาร​เป็นพิษ</link>ไม่​มีผลต่อ​ดู​พลิ​แคนต์คน​นี้"

#. STRINGS.DUPLICANTS.TRAITS.IRRITABLEBOWEL.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.IRRITABLEBOWEL.DESC"
msgid "This Duplicant needs a little extra time to \"do their business\""
msgstr "ดู​พลิ​แคนต์คน​นี้​ต้อง​ใช้เวลา \"ทำ​ธุระ\" นาน​กว่า​คนอื่น​นิดหน่อย"

#. STRINGS.DUPLICANTS.TRAITS.IRRITABLEBOWEL.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.IRRITABLEBOWEL.NAME"
msgid "Irritable Bowel"
msgstr "ลำไส้​แปรปรวน"

#. STRINGS.DUPLICANTS.TRAITS.LONER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.LONER.DESC"
msgid "This Duplicant prefers solitary pursuits"
msgstr "ดู​พลิ​แคนต์คน​นี้​ชอบ​ทำ​อะไร​คนเดียว"

#. STRINGS.DUPLICANTS.TRAITS.LONER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.LONER.NAME"
msgid "Loner"
msgstr "สันโดษ"

#. STRINGS.DUPLICANTS.TRAITS.LONER.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.LONER.SHORT_DESC"
msgid "Attribute bonuses while alone"
msgstr "โบนัส​คุณสมบัติ​เมื่อ​อยู่​คนเดียว"

#. STRINGS.DUPLICANTS.TRAITS.LONER.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.LONER.SHORT_DESC_TOOLTIP"
msgid "Only Duplicant on a world: <b>+4</b> bonus to all <style=\"KKeyword\">Attributes</style>"
msgstr "เป็น​ดู​พลิ​แคนต์​คนเดียว​บน​โลก: โบนัส <b>+4</b> กับ<style=\"KKeyword\">คุณสมบัติ</style>ทั้งหมด"

#. STRINGS.DUPLICANTS.TRAITS.MACHINERYDOWN.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.MACHINERYDOWN.DESC"
msgid "This Duplicant always invites friends over just to make them hook up their electronics"
msgstr "ดู​พลิ​แคนต์คน​นี้​ชวน​เพื่อน​มา​บ้าน​ทุกครั้ง​เพื่อให้​ช่วย​ต่อ​อุปกรณ์​อิเล็กทรอนิกส์"

#. STRINGS.DUPLICANTS.TRAITS.MACHINERYDOWN.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.MACHINERYDOWN.NAME"
msgid "Luddite"
msgstr "ต่อต้าน​เทคโนโลยี"

#. STRINGS.DUPLICANTS.TRAITS.METEORPHILE.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.METEORPHILE.DESC"
msgid "Meteor showers get this Duplicant really, really hyped"
msgstr "ฝนดาวตก​ทำให้​ดู​พลิ​แคนต์คน​นี้​คึก​สุด​ๆ"

#. STRINGS.DUPLICANTS.TRAITS.METEORPHILE.EXTENDED_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.METEORPHILE.EXTENDED_DESC"
msgid "• During meteor showers: <b>{0}</b> bonus to all <style=\"KKeyword\">Attributes</style>"
msgstr "• ระหว่าง​ฝนดาวตก: โบนัส <b>{0}</b> กับ<style=\"KKeyword\">คุณสมบัติ</style>ทั้งหมด"

#. STRINGS.DUPLICANTS.TRAITS.METEORPHILE.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.METEORPHILE.NAME"
msgid "Rock Fan"
msgstr "แฟน​พันธุ์​ร็อก"

#. STRINGS.DUPLICANTS.TRAITS.METEORPHILE.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.METEORPHILE.SHORT_DESC"
msgid "Gains Attribute bonuses during meteor showers."
msgstr "ได้​โบนัส​คุณสมบัติ​ระหว่าง​ฝนดาวตก"

#. STRINGS.DUPLICANTS.TRAITS.METEORPHILE.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.METEORPHILE.SHORT_DESC_TOOLTIP"
msgid "During meteor showers: <b>+3</b> bonus to all <style=\"KKeyword\">Attributes</style>"
msgstr "ระหว่าง​ฝนดาวตก: โบนัส <b>+3</b> กับ<style=\"KKeyword\">คุณสมบัติ</style>ทั้งหมด"

#. STRINGS.DUPLICANTS.TRAITS.MOLEHANDS.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.MOLEHANDS.DESC"
msgid "They're great for tunneling, but finding good gloves is a nightmare"
msgstr "ขุด​อุโมงค์​ได้​เยี่ยม แต่​หา​ถุง​มือดี​ๆ ใส่​นี่​ฝันร้าย​เลย"

#. STRINGS.DUPLICANTS.TRAITS.MOLEHANDS.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.MOLEHANDS.NAME"
msgid "Mole Hands"
msgstr "มือ​ตุ่น"

#. STRINGS.DUPLICANTS.TRAITS.MOUTHBREATHER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.MOUTHBREATHER.DESC"
msgid "This Duplicant sucks up way more than their fair share of <link=\"OXYGEN\">Oxygen</link>"
msgstr "ดู​พลิ​แคนต์คน​นี้​สูบ<link=\"OXYGEN\">ออกซิเจน</link>มากกว่า​ส่วน​ที่​ควร​ได้​เยอะ"

#. STRINGS.DUPLICANTS.TRAITS.MOUTHBREATHER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.MOUTHBREATHER.NAME"
msgid "Mouth Breather"
msgstr "หายใจ​ทาง​ปาก"

#. STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.DESC"
msgid "This Duplicant can and will fall asleep anytime, anyplace"
msgstr "ดู​พลิ​แคนต์คน​นี้​หลับ​ได้​ทุกที่​ทุกเวลา และ​จะ​หลับ​จริงๆ"

#. STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.NAME"
msgid "Narcoleptic"
msgstr "โรค​ลม​หลับ"

#. STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.SHORT_DESC"
msgid "Falls asleep periodically"
msgstr "หลับ​เป็นระยะ"

#. STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.NARCOLEPSY.SHORT_DESC_TOOLTIP"
msgid "This Duplicant's work will be periodically interrupted by naps"
msgstr "งาน​ของ​ดู​พลิ​แคนต์คน​นี้​จะ​ถูก​ขัดจังหวะ​ด้วย​การ​งีบ​เป็นระยะ"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.CLAUSTROPHOBIC.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.CLAUSTROPHOBIC.DESC"
msgid "This Duplicant feels suffocated in spaces fewer than four tiles high or three tiles wide"
msgstr "ดู​พลิ​แคนต์คน​นี้​รู้สึก​อึดอัด​ใน​ที่​ที่สูง​ไม่​ถึง​สี่​ช่อง​หรือ​กว้าง​ไม่​ถึง​สาม​ช่อง"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.CLAUSTROPHOBIC.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.CLAUSTROPHOBIC.NAME"
msgid "Claustrophobic"
msgstr "กลัว​ที่​แคบ"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.CLIMACOPHOBIC.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.CLIMACOPHOBIC.DESC"
msgid "Climbing ladders more than four tiles tall makes this Duplicant's stomach do flips"
msgstr "การ​ปีน​บันได​สูง​เกิน​สี่​ช่อง​ทำให้​ท้อง​ไส้​ดู​พลิ​แคนต์คน​นี้​ปั่นป่วน"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.CLIMACOPHOBIC.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.CLIMACOPHOBIC.NAME"
msgid "Vertigo Prone"
msgstr "กลัว​ความสูง"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.FASHIONABLE.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.FASHIONABLE.DESC"
msgid "This Duplicant dies a bit inside when forced to wear unstylish clothing"
msgstr "ดู​พลิ​แคนต์คน​นี้​ใจสลาย​นิดๆ เมื่อ​ต้อง​ใส่​เสื้อผ้า​ไม่​มี​สไตล์"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.FASHIONABLE.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.FASHIONABLE.NAME"
msgid "Fashionista"
msgstr "แฟชั่น​นิ​สต้า"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.PREFERSCOOLER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.PREFERSCOOLER.DESC"
msgid "This Duplicant has some extra <style=\"KKeyword\">Insulation</style>, so the room <style=\"KKeyword\">Temperature</style> affects them a little less"
msgstr "ดู​พลิ​แคนต์คน​นี้​มี<style=\"KKeyword\">ฉนวน</style>เสริม <style=\"KKeyword\">อุณหภูมิ</style>ห้อง​เลย​กระทบ​น้อยลง​หน่อย"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.PREFERSCOOLER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.PREFERSCOOLER.NAME"
msgid "Pudgy"
msgstr "จ้ำม่ำ"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.PREFERSWARMER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.PREFERSWARMER.DESC"
msgid "This Duplicant doesn't have much <style=\"KKeyword\">Insulation</style>, so they are more <style=\"KKeyword\">Temperature</style> sensitive than others"
msgstr "ดู​พลิ​แคนต์คน​นี้​มี<style=\"KKeyword\">ฉนวน</style>น้อย เลย​ไว​ต่อ<style=\"KKeyword\">อุณหภูมิ</style>กว่า​คนอื่น"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.PREFERSWARMER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.PREFERSWARMER.NAME"
msgid "Skinny"
msgstr "ผอมแห้ง"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.SENSITIVEFEET.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.SENSITIVEFEET.DESC"
msgid "This Duplicant is a sensitive sole and would rather walk on tile than raw bedrock"
msgstr "ฝ่าเท้า​ของ​ดู​พลิ​แคนต์คน​นี้​บอบบาง ขอ​เดิน​บน​แผ่น​ปูพื้น​ดีกว่า​หิน​ดิบ"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.SENSITIVEFEET.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.SENSITIVEFEET.NAME"
msgid "Delicate Feetsies"
msgstr "เท้า​บอบบาง"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.SOLITARYSLEEPER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.SOLITARYSLEEPER.DESC"
msgid "This Duplicant prefers to sleep alone"
msgstr "ดู​พลิ​แคนต์คน​นี้​ชอบ​นอน​คนเดียว"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.SOLITARYSLEEPER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.SOLITARYSLEEPER.NAME"
msgid "Solitary Sleeper"
msgstr "นอน​เดี่ยว"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.WORKAHOLIC.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.WORKAHOLIC.DESC"
msgid "This Duplicant gets antsy when left idle"
msgstr "ดู​พลิ​แคนต์คน​นี้​อยู่ไม่สุข​เมื่อ​ไม่​มี​อะไร​ทำ"

#. STRINGS.DUPLICANTS.TRAITS.NEEDS.WORKAHOLIC.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NEEDS.WORKAHOLIC.NAME"
msgid "Workaholic"
msgstr "บ้า​งาน"

#. STRINGS.DUPLICANTS.TRAITS.NIGHTLIGHT.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NIGHTLIGHT.DESC"
msgid "This Duplicant will imagine scary shapes in the dark all night if no one leaves a light on"
msgstr "ดู​พลิ​แคนต์คน​นี้​จะ​จินตนาการ​เห็น​รูปร่าง​น่ากลัว​ใน​ความมืด​ทั้งคืน​ถ้า​ไม่​มี​ใคร​เปิดไฟ​ทิ้ง​ไว้"

#. STRINGS.DUPLICANTS.TRAITS.NIGHTLIGHT.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NIGHTLIGHT.NAME"
msgid "Nyctophobic"
msgstr "กลัว​ความมืด"

#. STRINGS.DUPLICANTS.TRAITS.NIGHTLIGHT.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NIGHTLIGHT.SHORT_DESC"
msgid "Requires light to sleep"
msgstr "ต้อง​มี​แสง​ถึง​จะ​นอน​ได้"

#. STRINGS.DUPLICANTS.TRAITS.NIGHTLIGHT.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.NIGHTLIGHT.SHORT_DESC_TOOLTIP"
msgid "This Duplicant can't sleep in complete darkness"
msgstr "ดู​พลิ​แคนต์คน​นี้​นอน​ใน​ที่​มืดสนิท​ไม่​ได้"

#. STRINGS.DUPLICANTS.TRAITS.NIGHTOWL.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NIGHTOWL.DESC"
msgid "This Duplicant does their best work when they'd ought to be sleeping"
msgstr "ดู​พลิ​แคนต์คน​นี้​ทำงาน​ได้ดี​ที่สุด​ตอนที่​ควรจะ​นอน"

#. STRINGS.DUPLICANTS.TRAITS.NIGHTOWL.EXTENDED_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NIGHTOWL.EXTENDED_DESC"
msgid ""
"• Nighttime: <b>{0}</b> bonus to all <style=\"KKeyword\">Attributes</style>\n"
"• Duration: All Night"
msgstr ""
"• ตอนกลางคืน: โบนัส <b>{0}</b> กับ<style=\"KKeyword\">คุณสมบัติ</style>ทั้งหมด\n"
"• ระยะเวลา: ทั้งคืน"

#. STRINGS.DUPLICANTS.TRAITS.NIGHTOWL.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NIGHTOWL.NAME"
msgid "Night Owl"
msgstr "นกฮูก​กลางคืน"

#. STRINGS.DUPLICANTS.TRAITS.NIGHTOWL.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NIGHTOWL.SHORT_DESC"
msgid "Gains nighttime Attribute bonuses"
msgstr "ได้​โบนัส​คุณสมบัติ​ตอนกลางคืน"

#. STRINGS.DUPLICANTS.TRAITS.NIGHTOWL.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.NIGHTOWL.SHORT_DESC_TOOLTIP"
msgid ""
"Nighttime: <b>+3</b> bonus to all <style=\"KKeyword\">Attributes</style>\n"
"• Duration: All Night"
msgstr ""
"ตอนกลางคืน: โบนัส <b>+3</b> กับ<style=\"KKeyword\">คุณสมบัติ</style>ทั้งหมด\n"
"• ระยะเวลา: ทั้งคืน"

#. STRINGS.DUPLICANTS.TRAITS.NOODLEARMS.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.NOODLEARMS.DESC"
msgid "This Duplicant's arms have all the tensile strength of overcooked linguine"
msgstr "แขน​ของ​ดู​พลิ​แคนต์คน​นี้​แข็งแรง​พอ​ๆ กับ​เส้น​พาสต้า​ที่​ต้ม​เปื่อย"

#. STRINGS.DUPLICANTS.TRAITS.NOODLEARMS.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.NOODLEARMS.NAME"
msgid "Noodle Arms"
msgstr "แขน​เส้นหมี่"

#. STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.DESC"
msgid "This Duplicant eats radiation for breakfast (and dinner)"
msgstr "ดู​พลิ​แคนต์คน​นี้​กิน​รังสี​เป็น​อาหารเช้า (และ​เย็น)"

#. STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.NAME"
msgid "Radiation Eater"
msgstr "นักกิน​รังสี"

#. STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.SHORT_DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.SHORT_DESC"
msgid "Converts radiation exposure into calories"
msgstr "แปลง​รังสี​ที่​ได้รับ​เป็น​แคลอรี"

#. STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.SHORT_DESC_TOOLTIP
msgctxt "STRINGS.DUPLICANTS.TRAITS.RADIATIONEATER.SHORT_DESC_TOOLTIP"
msgid "Converts radiation exposure into calories"
msgstr "แปลง​รังสี​ที่​ได้รับ​เป็น​แคลอรี"

#. STRINGS.DUPLICANTS.TRAITS.RANCHINGDOWN.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.RANCHINGDOWN.DESC"
msgid "This Duplicant just doesn't trust those beady little eyes"
msgstr "ดู​พลิ​แคนต์คน​นี้​ไม่​ไว้ใจ​ตากลม​เล็ก​ๆ พวก​นั้น​เลย"

#. STRINGS.DUPLICANTS.TRAITS.RANCHINGDOWN.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.RANCHINGDOWN.NAME"
msgid "Critter Aversion"
msgstr "เกลียด​สัตว์"

#. STRINGS.DUPLICANTS.TRAITS.RANCHINGUP.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.RANCHINGUP.DESC"
msgid "The fuzzy snoots! The little claws! The chitinous exoskeletons! This Duplicant's never met a critter they didn't like"
msgstr "จมูก​ฟู​ๆ! กรงเล็บ​จิ๋ว! เปลือก​แข็ง​ไค​ติ​น​วาววับ! ดู​พลิ​แคนต์คน​นี้​ไม่​เคย​เจอ​สัตว์​ตัว​ไหน​ที่​ไม่​ชอบ"

#. STRINGS.DUPLICANTS.TRAITS.RANCHINGUP.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.RANCHINGUP.NAME"
msgid "Animal Lover"
msgstr "ทาส​สัตว์"

#. STRINGS.DUPLICANTS.TRAITS.REFUSES_TO_DO_TASK
msgctxt "STRINGS.DUPLICANTS.TRAITS.REFUSES_TO_DO_TASK"
msgid "Cannot do <b>{0} Errands</b>"
msgstr "ทำ<b>งาน{0}</b>ไม่​ได้"

#. STRINGS.DUPLICANTS.TRAITS.REGENERATION.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.REGENERATION.DESC"
msgid "This robust Duplicant is constantly regenerating health"
msgstr "ดู​พลิ​แคนต์​ตัว​แกร่ง​คน​นี้​ฟื้น​พลัง​ชีวิต​ตลอดเวลา"

#. STRINGS.DUPLICANTS.TRAITS.REGENERATION.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.REGENERATION.NAME"
msgid "Regenerative"
msgstr "ฟื้นฟู​ตัวเอง"

#. STRINGS.DUPLICANTS.TRAITS.ROBODANCER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.ROBODANCER.DESC"
msgid "This Duplicant breaks into dance when they are <style=\"KKeyword\">Overjoyed</style>"
msgstr "ดู​พลิ​แคนต์คน​นี้​เต้น​ออกมา​เอง​ตอน<style=\"KKeyword\">ดีใจ​สุดขีด</style>"

#. STRINGS.DUPLICANTS.TRAITS.ROBODANCER.NAME
msgctxt "STRINGS.DUPLICANTS.TRAITS.ROBODANCER.NAME"
msgid "Flash Mobber"
msgstr "นัก​แฟลช​ม็อบ"

#. STRINGS.DUPLICANTS.TRAITS.ROCKCRUSHER.DESC
msgctxt "STRINGS.DUPLICANTS.TRAITS.ROCKCRUSHER.DESC"
msgid "This Duplicant's got muscles on their muscles!"
